# ==============================================================================
# LA NUEVA PARISIENNE - CONFIGURACIÓN DE SEGURIDAD APACHE (.HTACCESS)
# ==============================================================================

# 1. Deshabilitar listado de directorios (Directory Browsing)
Options -Indexes

# 2. Bloquear acceso a archivos y directorios sensibles
<IfModule mod_authz_core.c>
    # Bloquear volcados de base de datos SQL, archivos .env y de configuración/caché
    <FilesMatch "(^\.git|^\.env|.*\.sql$|cache_.*\.json$|\.log$)">
        Require all denied
    </FilesMatch>

    # Bloquear carpetas de desarrollo interno e IDE
    <FilesMatch "^(brain|scratch)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(^\.git|^\.env|.*\.sql$|cache_.*\.json$|\.log$)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 3. Proteger la carpeta database/ explícitamente
RedirectMatch 403 ^/database/.*$

# 4. Cabeceras de seguridad HTTP básicas si mod_headers está disponible
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Codificación de caracteres por defecto
AddDefaultCharset UTF-8

# ==============================================================================
# 6. OPTIMIZACIÓN DE RENDIMIENTO: COMPRESIÓN GZIP (MOD_DEFLATE)
# Reduce el tamaño de transferencia de JS, CSS y HTML entre un 70% y 80%
# ==============================================================================
<IfModule mod_deflate.c>
    # Comprimir tipos MIME clave
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/truetype
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2

    # Asegurar que proxies no almacenen versiones incorrectas
    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>
</IfModule>

# ==============================================================================
# 7. OPTIMIZACIÓN DE CACHÉ DE NAVEGADOR (MOD_EXPIRES & CACHE-CONTROL)
# Carga instantánea (0 ms) de recursos estáticos en visitas subsiguientes
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"

    # Fuentes web (1 año)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/opentype "access plus 1 year"

    # Imágenes y assets multimedia (1 mes)
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # Estilos CSS y JavaScript de módulos (Sin caché en desarrollo para reflejar cambios de inmediato)
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"

    # HTML y JSON de APIs (no almacenar en caché persistente)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>
